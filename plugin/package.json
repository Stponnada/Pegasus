  "type": "module",
  "license": "MIT",
  "author": "Sriniketh Ponnada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stponnada/Pegasus.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/Stponnada/Pegasus/tree/main/plugin#readme",
  "bugs": "https://github.com/Stponnada/Pegasus/issues",
  "keywords": ["opencode", "opencode-plugin", "memory", "knowledge-graph", "llm"],
  "main": "src/index.ts",
